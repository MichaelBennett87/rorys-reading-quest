{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rrq-read-write-free-pilot-test",
  "main": "worker.ts",
  "compatibility_date": "2026-09-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "WRITING_LEDGER",
        "class_name": "WritingPilotLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WritingPilotLedger"]
    }
  ],
  "vars": {
    "RRQ_ALLOWED_ORIGIN": "http://127.0.0.1:8798",
    "RRQ_DAILY_APPLICATION_NEURON_LIMIT": "4000",
    "RRQ_AUTHORIZATION_TTL_DAYS": "2",
    "RRQ_PAID_ROUTES_DISABLED": "true",
    "RRQ_CONTROLLED_PROVIDER": "true"
  },
  "observability": {
    "enabled": false
  }
}

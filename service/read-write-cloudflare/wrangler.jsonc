{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rrq-read-write-free-pilot",
  "main": "worker.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WRITING_LEDGER",
        "class_name": "WritingPilotLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WritingPilotLedger"]
    }
  ],
  "vars": {
    "RRQ_ALLOWED_ORIGIN": "https://michaelbennett87.github.io",
    "RRQ_DAILY_APPLICATION_NEURON_LIMIT": "4000",
    "RRQ_AUTHORIZATION_TTL_DAYS": "30",
    "RRQ_PAID_ROUTES_DISABLED": "true"
  },
  "observability": {
    "enabled": false
  }
}
